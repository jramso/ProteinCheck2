{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Stores user settings and goals.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "displayName": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "photoURL": { "type": "string", "format": "uri" },
        "weight": { "type": "number", "description": "Current weight" },
        "height": { "type": "number", "description": "Height in cm" },
        "proteinGoal": { "type": "number", "description": "Daily protein goal in grams" },
        "multiplier": { "type": "number", "description": "Protein multiplier (e.g., 2.0)" },
        "autoCalculate": { "type": "boolean" },
        "weightUnit": { "type": "string", "enum": ["kg", "lb"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email"]
    },
    "Meal": {
      "title": "Meal Entry",
      "description": "A single meal log entry.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "protein": { "type": "number" },
        "timestamp": { "type": "string", "format": "date-time" },
        "imageUrl": { "type": "string", "format": "uri" }
      },
      "required": ["name", "protein", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile document"
    },
    "/users/{userId}/meals/{mealId}": {
      "schema": "Meal",
      "description": "Collection of meals for a specific user"
    }
  }
}
